{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "AI": {
    "Enabled": true,
    "FreeOnly": true,
    "FallbackEnabled": true,
    "ProviderOrder": "Gemini,Groq",
    "CloudConsentRequired": true,
    "Temperature": 0.1,
    "MaxOutputTokens": 8192,
    "RequestTimeoutSeconds": 240,
    "ProviderTimeoutSeconds": 90,
    "RetryLimit": 1,
    "DailyUsageLimit": 10,
    "MaxInputCharacters": 500000,
    "MaxUseCaseCharacters": 10000,
    "MaxInferenceCallsPerRequest": 500,
    "FreeTierAnalysisMode": false,
    "CacheDurationMinutes": 10,
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "OpenSeconds": 60
    },
    "Providers": {
      "Gemini": {
        "Enabled": true,
        "Priority": 1,
        "Model": "gemini-3.1-flash-lite",
        "FreeTierConfirmed": false
      },
      "Groq": {
        "Enabled": true,
        "Priority": 2,
        "Model": "openai/gpt-oss-120b",
        "BaseUrl": "https://api.groq.com/openai/v1/"
      }
    }
  },
  "Analysis": {
    "Provider": "Gemini",
    "ChunkCharacters": 12000,
    "ChunkOverlapLines": 5,
    "MaxChunks": 40,
    "MaxParallelCalls": 1,
    "MaxConsolidationFindings": 250
  },
  "ConnectionStrings": {
    "DigestDb": "Server=(localdb)\\mssqllocaldb;Database=AI.Digest;Trusted_Connection=true"
  },
  "Cors": { "Origins": "http://localhost:4200,http://127.0.0.1:4200" },
  "AllowedHosts": "*"
}
