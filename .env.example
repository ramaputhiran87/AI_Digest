# Template only: ASP.NET Core does not load .env files automatically.
# Set these as backend process/deployment environment variables or .NET User Secrets.
# Provider order is primary-to-secondary. Keys are read only by the backend.
AI_ENABLED=true
AI_FREE_ONLY=true
AI_FALLBACK_ENABLED=true
AI_PROVIDER_ORDER=gemini,groq
# Only needed to protect admin-only endpoints when Azure AD role authorization is not configured.
AI_ADMIN_TOKEN=
AI_CLOUD_CONSENT_REQUIRED=true
AI_DAILY_USAGE_LIMIT=10
AI_REQUEST_TIMEOUT_SECONDS=240
AI_PROVIDER_TIMEOUT_SECONDS=90
AI_RETRY_LIMIT=1
AI_MAX_INFERENCE_CALLS_PER_REQUEST=500
AI_FREE_TIER_ANALYSIS_MODE=false
AI_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=8192
AI_SETTINGS_PATH=
AI_DATA_PROTECTION_KEYS_PATH=
# Optional encrypted consent-record path; defaults to the backend user's LocalAppData/AI.Digest folder.
AI_CONSENT_STORE_PATH=

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Set true only after confirming the Google project uses the free tier and billing is disabled.
GEMINI_FREE_TIER_CONFIRMED=false

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The configured GPT-OSS 120B model is priced by Groq and is blocked while AI_FREE_ONLY=true.
# Do not disable free-only unless paid usage is explicitly approved.
